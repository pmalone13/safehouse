# Ignore everything by default...
/*

# ...except top-level source/doc files.
!/*.py
!/README.md
!/LICENSE
!/CLAUDE.md
!/.gitignore
!/requirements.txt

# ...and the systemd unit files.
!/systemd/
!/systemd/*.service

# ...and the projects/ tree, recursively -- each project/sub-project's own
# CLAUDE.md plus whatever working files it accumulates. This is Claude's
# own workspace; shared/deliverable content lives on Google Drive instead,
# not in this repo (see root CLAUDE.md).
!/projects/
!/projects/**

/__pycache__/
*.pyc
/projects/**/__pycache__/

# Runtime/ephemeral state -- deliberately NOT backed up via git, unlike
# bayhouse's own tracked .db files. queue.db is a transient work queue
# (a processed message has no lasting value); logs.db/logs/ are
# regenerated by logging_server.py. The durable record is CLAUDE.md's
# own checkpoint commits, not this.
/queue.db
/queue.db-wal
/queue.db-shm
/logs.db
/logs/

# venv, credentials -- never committed.
/venv/
