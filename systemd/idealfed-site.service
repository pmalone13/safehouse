[Unit]
Description=idealfed.com static site (About/Privacy/Terms)
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/safehouse/idealfed_site
ExecStart=/home/ubuntu/safehouse/venv/bin/gunicorn --workers 1 --bind 127.0.0.1:8091 app:app
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
