[Unit]
Description=safehouse email monitor (tedassistent@gmail.com -> queue)
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/safehouse
ExecStart=/home/ubuntu/safehouse/venv/bin/python3 /home/ubuntu/safehouse/email_monitor.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
